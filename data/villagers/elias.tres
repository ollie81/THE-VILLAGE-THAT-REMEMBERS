[resource]
script = ExtResource("1_data")
id = &"elias"
display_name = "Elias"
age = 35
role = "Farmer"
traits = PackedStringArray("Generous", "Hardworking", "Patient")
biography = "Elias was first in the fields every morning and the last to leave. Whatever the harvest, he makes sure nobody in the village goes hungry."
appearance = SubResource("Resource_look")
home_location = "home_elias"
walk_speed = 1.5
schedule = [{"hour": 5.0, "activity": "work", "location": "farm", "label": "Tending the crops at dawn", "anim": "work"}, {"hour": 12.0, "activity": "socialize", "location": "plaza", "label": "Sharing lunch at the meeting circle"}, {"hour": 13.0, "activity": "work", "location": "farm", "label": "Working the fields", "anim": "work"}, {"hour": 16.5, "activity": "work", "location": "storage", "label": "Storing the day's harvest"}, {"hour": 18.0, "activity": "socialize", "location": "plaza"}, {"hour": 21.0, "activity": "sleep", "location": "home"}]
wander_locations = PackedStringArray("farm", "plaza", "garden")
first_meeting_lines = PackedStringArray("Welcome! You look like you could use a meal. There's always bread to spare at my table.", "The soil here is good. Treat it kindly and it remembers.")
returning_lines = PackedStringArray("The wheat's turning gold. Another few weeks.", "Nothing grows faster for being shouted at. I've tried.", "Take a cabbage if you need one. Really, take two.")
activity_comments = {"work": "Each row in its own time. You can't rush a field.", "socialize": "Good food tastes better when it's shared.", "rest": "Even the land rests. So should we."}
personality = {"openness": 0.4, "conscientiousness": 0.8, "extraversion": 0.45, "agreeableness": 0.95, "neuroticism": 0.2, "patience": 0.95}
