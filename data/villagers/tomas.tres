[resource]
script = ExtResource("1_data")
id = &"tomas"
display_name = "Tomas"
age = 61
role = "Craftsman"
traits = PackedStringArray("Wise", "Patient", "Traditional")
biography = "Tomas has carved, forged and mended nearly every tool in the village. He remembers how things were done before, and he believes the old ways are worth keeping."
appearance = SubResource("Resource_look")
home_location = "home_tomas"
walk_speed = 1.15
schedule = [{"hour": 6.0, "activity": "socialize", "location": "plaza", "label": "Watching the sunrise by the fire"}, {"hour": 8.0, "activity": "work", "location": "workshop", "label": "Shaping tools at the workshop", "anim": "work"}, {"hour": 12.0, "activity": "rest", "location": "home", "label": "Resting at home"}, {"hour": 14.0, "activity": "work", "location": "workshop", "label": "Mending tools at the workshop", "anim": "work"}, {"hour": 18.0, "activity": "socialize", "location": "plaza", "label": "Telling old stories by the fire"}, {"hour": 21.0, "activity": "sleep", "location": "home"}]
wander_locations = PackedStringArray("plaza", "workshop")
first_meeting_lines = PackedStringArray("A new face. Sit, sit. My knees prefer conversations that happen sitting down.", "My grandfather carved the story stone in the meeting circle. Every mark is something this village chose to remember.")
returning_lines = PackedStringArray("A good tool outlives the hand that made it. A good name outlives both.", "The young ones want everything faster. Wood doesn't care what you want.", "You came back. That's how a stranger becomes a neighbour.")
activity_comments = {"work": "Steady hands, steady heart. Pass me that file, would you?", "socialize": "Pull up a log. The fire has heard all my stories, but you haven't.", "rest": "An old man's afternoon nap is sacred, you know."}
personality = {"openness": 0.3, "conscientiousness": 0.9, "extraversion": 0.4, "agreeableness": 0.75, "neuroticism": 0.25, "tradition": 0.95}
