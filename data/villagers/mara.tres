[resource]
script = ExtResource("1_data")
id = &"mara"
display_name = "Mara"
age = 29
role = "Builder"
traits = PackedStringArray("Practical", "Courageous", "Protective")
biography = "Mara raised half the roofs in the village with her own hands. She is building a sixth house on the western edge, for whoever the village needs next."
appearance = SubResource("Resource_look")
home_location = "home_mara"
walk_speed = 1.75
schedule = [{"hour": 5.5, "activity": "socialize", "location": "plaza", "label": "Warming up by the morning fire"}, {"hour": 7.0, "activity": "work", "location": "build_site", "label": "Raising the frame of the new house", "anim": "work"}, {"hour": 12.0, "activity": "socialize", "location": "plaza", "label": "Eating lunch at the meeting circle"}, {"hour": 13.0, "activity": "work", "location": "storage", "label": "Hauling timber from the storehouse"}, {"hour": 15.0, "activity": "work", "location": "build_site", "label": "Fitting planks on the new house"}, {"hour": 18.0, "activity": "wander", "location": ""}, {"hour": 19.5, "activity": "socialize", "location": "plaza"}, {"hour": 22.0, "activity": "sleep", "location": "home"}]
wander_locations = PackedStringArray("bridge", "riverbank", "workshop", "plaza")
first_meeting_lines = PackedStringArray("[worried]Mind the frame by the west path, it isn't braced yet.", "[angry]If anything ever threatens this village, you come find me first. Understood?")
returning_lines = PackedStringArray("[happy]The new house is coming along. Slowly, but it'll stand for a hundred years.", "[laughing]Tomas says I hammer like I'm angry at the nails. I'm not. Mostly.", "Walls keep out the weather. People keep out everything else.")
activity_comments = {"work": "[worried]I can't stop long, these beams won't lift themselves.", "socialize": "A fire, some company... that's what we build for, isn't it?", "wander": "Just walking the village, checking every roof I've made."}
personality = {"openness": 0.45, "conscientiousness": 0.85, "extraversion": 0.5, "agreeableness": 0.55, "neuroticism": 0.3, "courage": 0.9}
