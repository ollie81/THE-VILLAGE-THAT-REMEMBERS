extends Node
## Everything the player hears apart from voices: music, sound effects and
## the sounds of the village (birds by day, crickets at night, wind, the
## fire). All of it is generated by the game itself (see Synth and Music).
##
## Three volumes in Settings: Music, Effects and Ambience (audio buses).

signal music_ready

const BUS_MUSIC := "Music"
const BUS_EFFECTS := "Effects"
const BUS_AMBIENCE := "Ambience"
const SETTINGS_PATH := "user://sound.cfg"
## How long the day and night themes take to fade into each other.
const CROSSFADE := 6.0
const MAX_PLAYERS := 12

var volumes := {BUS_MUSIC: 0.55, BUS_EFFECTS: 0.8, BUS_AMBIENCE: 0.6}
## True inside a home (the outdoor ambience is muffled).
var indoor: bool = false
const INDOOR_AMBIENCE_DB := -12.0
## Tests switch this off so they don't overwrite the player's volume settings.
var persist: bool = true
## The last few effects that actually played (for tests and debugging).
var history: Array[String] = []

var _effects: Dictionary = {}  # name -> Array[AudioStreamWAV] (variations)
var _players: Array[AudioStreamPlayer] = []
var _music: Dictionary = {}  # theme -> AudioStreamWAV
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _theme: String = ""
var _render_task: int = -1
var _rendering: Dictionary = {}
var _wind: AudioStreamPlayer
var _creatures: AudioStreamPlayer
var _creature_timer: float = 2.0
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	_make_buses()
	_load_settings()
	_make_effects()
	for i in MAX_PLAYERS:
		var player := AudioStreamPlayer.new()
		player.bus = BUS_EFFECTS
		add_child(player)
		_players.append(player)
	_music_a = _music_player()
	_music_b = _music_player()
	_wind = AudioStreamPlayer.new()
	_wind.bus = BUS_AMBIENCE
	_wind.stream = Synth.to_stream(SoundBank.wind(), true)
	_wind.volume_db = -14.0
	add_child(_wind)
	_creatures = AudioStreamPlayer.new()
	_creatures.bus = BUS_AMBIENCE
	add_child(_creatures)
	for theme in [Music.DAY, Music.NIGHT]:
		var cached := Music.load_cached(theme)
		if cached:
			_music[theme] = cached


func _music_player() -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.bus = BUS_MUSIC
	player.volume_db = -80.0
	add_child(player)
	return player


# --- Buses and volume ---------------------------------------------------------------

func _make_buses() -> void:
	for bus in [BUS_MUSIC, BUS_EFFECTS, BUS_AMBIENCE]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var index := AudioServer.bus_count - 1
			AudioServer.set_bus_name(index, bus)
			AudioServer.set_bus_send(index, "Master")


func set_volume(bus: String, value: float) -> void:
	volumes[bus] = clampf(value, 0.0, 1.0)
	_apply_volume(bus)
	if persist:
		_save_settings()


func _apply_volume(bus: String) -> void:
	var index := AudioServer.get_bus_index(bus)
	if index == -1:
		return
	var value := float(volumes.get(bus, 1.0))
	AudioServer.set_bus_mute(index, value <= 0.001)
	var muffle := INDOOR_AMBIENCE_DB if indoor and bus == BUS_AMBIENCE else 0.0
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(value, 0.001)) + muffle)


## Indoors the wind and birds are muffled.
func set_indoor(value: bool) -> void:
	indoor = value
	_apply_volume(BUS_AMBIENCE)


func _load_settings() -> void:
	var config := ConfigFile.new()
	if config.load(SETTINGS_PATH) == OK:
		for bus in volumes:
			volumes[bus] = float(config.get_value("volume", bus, volumes[bus]))
	for bus in volumes:
		_apply_volume(bus)


func _save_settings() -> void:
	var config := ConfigFile.new()
	for bus in volumes:
		config.set_value("volume", bus, volumes[bus])
	config.save(SETTINGS_PATH)


# --- Effects ------------------------------------------------------------------------

## Plays a sound effect. `at` (a world position) makes distant sounds quieter.
func play(sound: String, at: Variant = null, volume_db: float = 0.0) -> void:
	var variants: Array = _effects.get(sound, [])
	if variants.is_empty():
		return
	var db := volume_db
	if at is Vector3:
		var camera := get_viewport().get_camera_3d()
		if camera:
			var distance := camera.global_position.distance_to(at)
			if distance > 30.0:
				return
			db -= distance * 0.6
	var player := _free_player()
	player.stream = variants[_rng.randi_range(0, variants.size() - 1)]
	player.pitch_scale = _rng.randf_range(0.93, 1.07)
	player.volume_db = db
	player.play()
	history.append(sound)
	if history.size() > 40:
		history.pop_front()


func _free_player() -> AudioStreamPlayer:
	for player in _players:
		if not player.playing:
			return player
	return _players[_rng.randi_range(0, _players.size() - 1)]


func has_effect(sound: String) -> bool:
	return _effects.has(sound)


func _make_effects() -> void:
	_effects = SoundBank.effects()


# --- Music ---------------------------------------------------------------------------

## Starts the music (the theme for the time of day). Themes that aren't
## saved yet are rendered in the background first.
func start_music() -> void:
	_render_missing()
	_update_theme(true)


func _render_missing() -> void:
	if _render_task != -1:
		return
	for theme in [Music.DAY, Music.NIGHT]:
		if not _music.has(theme):
			_render_task = WorkerThreadPool.add_task(_render.bind(theme), false, "Render music")
			_rendering = {"theme": theme}
			return


func _render(theme: String) -> void:
	_rendering["samples"] = Music.render(theme)


## The theme playing now ("" before the music starts).
func current_theme() -> String:
	return _theme


func is_music_ready() -> bool:
	return _music.has(Music.DAY) and _music.has(Music.NIGHT)


func _process(delta: float) -> void:
	if _render_task != -1 and WorkerThreadPool.is_task_completed(_render_task):
		WorkerThreadPool.wait_for_task_completion(_render_task)
		_render_task = -1
		var theme := String(_rendering["theme"])
		var stream := Synth.to_stream(_rendering["samples"], true)
		_music[theme] = stream
		Music.save_cached(theme, stream)
		_rendering = {}
		_render_missing()
		if is_music_ready():
			music_ready.emit()
		_update_theme(false)
	_update_theme(false)
	_fade(delta)
	_ambience(delta)


func _wanted_theme() -> String:
	return Music.NIGHT if WorldClock.time_of_day >= 20.0 or WorldClock.time_of_day < 5.5 else Music.DAY


func _update_theme(force: bool) -> void:
	var theme := _wanted_theme()
	if (theme == _theme and not force) or not _music.has(theme) or GameManager.player == null:
		return
	_theme = theme
	# The quiet player takes the new theme and fades in; the other fades out.
	var incoming := _music_a if _music_a.volume_db < _music_b.volume_db else _music_b
	incoming.stream = _music[theme]
	incoming.volume_db = -40.0
	incoming.play()
	incoming.set_meta("target", 0.0)
	var outgoing := _music_b if incoming == _music_a else _music_a
	outgoing.set_meta("target", -80.0)


func _fade(delta: float) -> void:
	for player in [_music_a, _music_b]:
		if not player.has_meta("target"):
			continue
		var target := float(player.get_meta("target"))
		player.volume_db = move_toward(player.volume_db, target, delta * 60.0 / CROSSFADE)
		if target <= -79.0 and player.volume_db <= -79.0 and player.playing:
			player.stop()


# --- Ambience ------------------------------------------------------------------------

func _ambience(delta: float) -> void:
	if GameManager.player == null:
		if _wind.playing:
			_wind.stop()
		return
	if not _wind.playing:
		_wind.play()
	_creature_timer -= delta
	if _creature_timer > 0.0:
		return
	var hour := WorldClock.time_of_day
	var night := hour >= 20.5 or hour < 5.0
	_creature_timer = _rng.randf_range(0.8, 2.0) if night else _rng.randf_range(2.5, 7.0)
	var sound := "cricket" if night else ("bird" if hour >= 5.5 and hour < 19.5 else "")
	if sound == "":
		return
	var variants: Array = _effects[sound]
	_creatures.stream = variants[_rng.randi_range(0, variants.size() - 1)]
	_creatures.pitch_scale = _rng.randf_range(0.9, 1.1)
	_creatures.volume_db = _rng.randf_range(-16.0, -9.0)
	_creatures.play()


static func fire_stream() -> AudioStreamWAV:
	return SoundBank.fire()


func _exit_tree() -> void:
	if _render_task != -1:
		WorkerThreadPool.wait_for_task_completion(_render_task)
		_render_task = -1
